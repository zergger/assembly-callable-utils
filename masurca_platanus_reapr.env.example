# Example config for masurca_platanus_reapr.sh
#
# Copy and edit:
#   cp masurca_platanus_reapr.env.example masurca_platanus_reapr.env
#
# Run:
#   bash masurca_platanus_reapr.sh masurca_platanus_reapr.env

SAMPLE_ID=sample1
WORKDIR=/path/to/work_masurca_platanus_reapr
MASURCA_CFG=/path/to/masurca.cfg

R1=/path/to/reads_R1.fastq.gz
R2=/path/to/reads_R2.fastq.gz

THREADS=10
MASURCA_THREADS=10
PLATANUS_THREADS=10
PLATANUS_MEM_GB=64
PLATANUS_BIN=platanus
PLATANUS_PREFIX=platanus_alt
PLATANUS_TMP=/path/to/work_masurca_platanus_reapr/platanus/tmp
# auto prefers pigz and falls back to gzip.
PLATANUS_DECOMPRESSOR=auto
PLATANUS_DECOMPRESS_THREADS=10

# At 1.0, Platanus plain FASTQ staging is removed after a non-empty contig is produced.
DOWNSAMPLE_FRAC=1.0
SEED=42

RUN_DRAFT_ASSEMBLY=1
RUN_REAPR_POLISH=1

PRIMARY_ASM=/path/to/work_masurca_platanus_reapr/masurca/CA/primary.genome.scf.fasta
DONOR_ASM=/path/to/work_masurca_platanus_reapr/platanus/platanus_alt_contig.fa

REAPR_THREADS=10
RAGTAG_THREADS=10
SAMTOOLS_THREADS=10

POLISHER=nextpolish
REAPR_ALIGNER=bwa-mem2
RUN_REAPR_PERFECTMAP=0
REAPR_FILTER_ENABLE=0
REAPR_BREAK_ENABLE=1
REAPR_BREAK_B=0
REAPR_BREAK_E=0.5

PY3=python3
MASURCA_BIN=masurca
REAPR_BIN=reapr
POLCA_BIN=polca.sh
NEXTPOLISH_BIN=nextPolish
GLOBAL_LOCK_FILE=/path/to/work_masurca_platanus_reapr/.pipeline.lock
GLOBAL_LOCK_WAIT_SEC=0
